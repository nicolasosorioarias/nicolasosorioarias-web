---
// Floating capsule header: mark and name, section links with the active-section node,
// EN/ES switch and a Contact button. Phones and narrow tablets get a Menu panel instead.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { nav, hero } = t;
// Contact lives in the button, so the inline links skip it; the phone menu keeps every section.
const inlineItems = nav.items.filter((item) => item.id !== 'contact');
---

<header class="site-header" data-header>
  <div class="capsule">
    <a class="brand" href="#top" aria-label={nav.home}>
      <Logo />
      <span>{hero.name}</span>
    </a>

    <nav class="primary-nav" aria-label={nav.label} data-primary-nav>
      <ul>
        {
          inlineItems.map((item) => (
            <li>
              <a href={`#${item.id}`} data-nav-link={item.id}>
                <span class="signal-link signal-link--quiet">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="capsule__end">
      <a class="lang" href={nav.language.otherHref} hreflang={nav.language.otherLang} lang={nav.language.otherLang}>
        <span class="lang__current" aria-hidden="true">{nav.language.current}</span>
        <span class="lang__other">{nav.language.other}</span>
        <span class="sr-only">, {nav.language.otherName}</span>
      </a>

      <a class="btn btn-primary cta" href="#contact" data-magnetic>
        {hero.ctaContact}
        <Icon name="arrow-right" />
      </a>

      <details class="menu">
        <summary>
          <span>{nav.menu}</span>
          <span class="menu__icon" aria-hidden="true"></span>
        </summary>
        <nav class="menu__panel" aria-label={nav.label}>
          <ul>
            {
              nav.items.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
    padding-inline: 16px;
    pointer-events: none;
  }

  .capsule {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    width: min(1180px, 100%);
    height: 60px;
    margin-inline: auto;
    padding: 0 9px 0 22px;
    border: 1px solid rgb(91 140 255 / 0.28);
    border-radius: 999px;
    /* 75% navy keeps every link above 4.5:1 over the brightest footage; blur calms what shows through. */
    background: rgb(10 18 34 / 0.75);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    box-shadow:
      inset 0 1px 0 rgb(169 196 255 / 0.14),
      0 18px 40px -18px rgb(0 0 0 / 0.8);
    transition:
      height 400ms var(--ease-out),
      background-color 400ms ease,
      border-color 400ms ease;
  }

  /* Past the hero: a little shorter and nearly opaque, so page text never shows through. */
  .site-header:global(.is-scrolled) .capsule {
    height: 52px;
    background: rgb(10 18 34 / 0.94);
    border-color: rgb(91 140 255 / 0.22);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 999px;
  }

  .primary-nav {
    position: relative;
    margin-inline: auto;
  }

  .primary-nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    color: var(--text);
    font-size: var(--fs-small);
    text-decoration: none;
  }

  .primary-nav a:global([aria-current='location']) {
    color: #fff;
  }

  /* A node that slides under the section being read. */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--key);
    box-shadow: 0 0 0 3px rgb(169 196 255 / 0.18);
    opacity: var(--no, 0);
    transform: translateX(var(--nx, 0px));
    transition:
      transform 500ms var(--ease-out),
      opacity 300ms ease;
  }

  .capsule__end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* EN/ES switch: the current language sits in the lit half. */
  .lang {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border: 1px solid rgb(91 140 255 / 0.28);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: border-color var(--dur-fast) ease;
  }

  .lang span:not(.sr-only) {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 10px;
    border-radius: 999px;
  }

  .lang__current {
    background: rgb(91 140 255 / 0.24);
    color: var(--text);
  }

  .lang__other {
    color: var(--label);
    transition: color var(--dur-fast) ease;
  }

  .lang:hover,
  .lang:focus-visible {
    border-color: var(--accent);
  }

  .lang:hover .lang__other,
  .lang:focus-visible .lang__other {
    color: var(--text);
  }

  .cta {
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: var(--fs-small);
  }

  .cta :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .cta:hover :global(svg),
  .cta:focus-visible :global(svg) {
    transform: translateX(3px);
  }

  .menu {
    position: relative;
    display: none;
  }

  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--night);
    font-size: var(--fs-small);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu__icon {
    width: 14px;
    height: 8px;
    border-block: 1.5px solid var(--night);
    transition: transform var(--dur-fast) ease;
  }

  .menu[open] .menu__icon {
    transform: rotate(90deg);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + 16px);
    right: -9px;
    width: min(320px, calc(100vw - 32px));
    padding: 8px;
    border: 1px solid rgb(91 140 255 / 0.28);
    border-radius: 20px;
    background: var(--night-raised);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.8);
  }

  .menu__panel ul {
    list-style: none;
  }

  .menu__panel a {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 0 14px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
  }

  .menu__panel a:hover,
  .menu__panel a:focus-visible {
    background: rgb(91 140 255 / 0.12);
  }

  /* Below 1080px the five links no longer fit next to the brand and actions. */
  @media (max-width: 1079px) {
    .primary-nav,
    .cta {
      display: none;
    }

    .capsule__end {
      margin-inline-start: auto;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .site-header {
      inset: 10px 0 auto;
      padding-inline: 10px;
    }

    .capsule {
      height: 54px;
      gap: 10px;
      padding: 0 7px 0 14px;
    }

    .brand {
      gap: 8px;
      font-size: 0.9375rem;
    }

    .lang span:not(.sr-only) {
      min-height: 32px;
      padding: 0 8px;
    }
  }

  @media (max-width: 359px) {
    .brand span {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = header?.querySelector<HTMLDetailsElement>('.menu');

  if (header) {
    let ticking = false;
    // Glass over the hero footage; shorter and nearly opaque once the hero is behind.
    const hero = document.querySelector<HTMLElement>('[data-hs], [data-hero]');
    const update = () => {
      const heroEnd = hero ? hero.offsetTop + hero.offsetHeight - header.offsetHeight - 16 : 0;
      header.classList.toggle('is-scrolled', window.scrollY > Math.max(24, heroEnd));
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // Section indicator: the node under the nav follows the section in view.
  const navEl = document.querySelector<HTMLElement>('[data-primary-nav]');
  const navLinks = navEl ? Array.from(navEl.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')) : [];
  if (navEl && navLinks.length) {
    const sections = navLinks
      .map((link) => document.getElementById(link.dataset.navLink ?? ''))
      .filter((section): section is HTMLElement => section !== null);
    let pending = false;
    const spy = () => {
      pending = false;
      const probe = window.innerHeight * 0.4;
      let active = -1;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= probe) active = index;
      });
      // In the closing section no inline link is active (Contact is the button).
      const contact = document.getElementById('contact');
      if (contact && contact.getBoundingClientRect().top <= probe) active = -1;
      navLinks.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const link = navLinks[active];
      navEl.style.setProperty('--no', link ? '1' : '0');
      if (link) navEl.style.setProperty('--nx', `${link.offsetLeft + link.offsetWidth / 2}px`);
    };
    spy();
    const schedule = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(spy);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }

  if (menu) {
    // Close the menu after choosing a section, on Escape, or on an outside click.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (menu.open = false)));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
