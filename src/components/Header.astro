---
import Logo from './Logo.astro';
import type { Content } from '../i18n';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { nav } = t;
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href="#top" aria-label={nav.home}>
      <Logo />
      <span>{t.hero.name}</span>
    </a>

    <nav class="primary-nav" aria-label={nav.label} data-primary-nav>
      <ul>
        {nav.items.map((item) => (
          <li>
            <a href={`#${item.id}`} data-nav-link={item.id}>
              <span class="signal-link signal-link--quiet">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="site-header__end">
      <a
        class="lang"
        href={nav.language.otherHref}
        hreflang={nav.language.otherLang}
        lang={nav.language.otherLang}
      >
        <span class="lang__current" aria-hidden="true">{nav.language.current}</span>
        <span class="lang__sep" aria-hidden="true">/</span>
        <span class="lang__other">{nav.language.other}</span>
        <span class="sr-only">, {nav.language.otherName}</span>
      </a>

      <details class="menu">
        <summary>
          <span>{nav.menu}</span>
          <span class="menu__icon" aria-hidden="true"></span>
        </summary>
        <nav class="menu__panel" aria-label={nav.label}>
          <ul>
            {nav.items.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-base) ease,
      border-color var(--dur-base) ease;
  }

  .site-header:global(.is-scrolled) {
    background: var(--night);
    border-bottom-color: var(--line);
  }

  /* Over the hero footage: translucent navy glass. 75% navy keeps every link above
     4.5:1 even over the brightest highlight, and the blur calms what shows through. */
  .site-header:global(.is-over-hero) {
    background: rgb(10 18 34 / 0.75);
    border-bottom-color: rgb(91 140 255 / 0.16);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  .site-header:global(.is-over-hero) .primary-nav a {
    color: var(--text);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter) + 96px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-nav {
    position: relative;
    margin-inline-start: auto;
  }

  /* A node that slides under the section being read. */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--key);
    box-shadow: 0 0 0 3px rgb(169 196 255 / 0.18);
    opacity: var(--no, 0);
    transform: translateX(var(--nx, 0px));
    transition:
      transform 500ms var(--ease-out),
      opacity 300ms ease;
  }

  .primary-nav a:global([aria-current='location']) {
    color: var(--text);
  }

  .primary-nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 6px;
    color: var(--text-2);
    font-size: var(--fs-small);
    text-decoration: none;
  }

  .primary-nav a:hover {
    color: var(--text);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .lang__current {
    color: var(--text);
  }

  .lang__sep {
    color: var(--line-strong);
  }

  .lang__other {
    color: var(--label);
  }

  .lang:hover {
    border-color: var(--accent);
  }

  .lang:hover .lang__other {
    color: var(--text);
  }

  .menu {
    position: relative;
    display: none;
  }

  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text);
    font-size: var(--fs-small);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu__icon {
    position: relative;
    width: 14px;
    height: 8px;
    border-block: 1.5px solid var(--key);
    transition: transform var(--dur-fast) ease;
  }

  .menu[open] .menu__icon {
    transform: rotate(90deg);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 220px;
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--night-raised);
    box-shadow: 0 12px 24px -10px rgb(0 0 0 / 0.55);
  }

  .menu__panel ul {
    list-style: none;
  }

  .menu__panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
  }

  .menu__panel a:hover {
    background: rgb(91 140 255 / 0.12);
  }

  @media (max-width: 959px) {
    .primary-nav {
      display: none;
    }

    .site-header__end {
      margin-inline-start: auto;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 380px) {
    .brand span {
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = header?.querySelector<HTMLDetailsElement>('.menu');

  if (header) {
    let ticking = false;
    // Glass while the header sits over the hero footage, the clean solid bar after it.
    const hero = document.querySelector<HTMLElement>('[data-hs], [data-hero]');
    const update = () => {
      const heroEnd = hero ? hero.offsetTop + hero.offsetHeight - header.offsetHeight : 0;
      const overHero = window.scrollY < heroEnd;
      header.classList.toggle('is-over-hero', overHero);
      header.classList.toggle('is-scrolled', !overHero && window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // Section indicator: the node under the nav follows the section in view.
  const navEl = document.querySelector<HTMLElement>('[data-primary-nav]');
  const navLinks = navEl ? Array.from(navEl.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')) : [];
  if (navEl && navLinks.length) {
    const sections = navLinks
      .map((link) => document.getElementById(link.dataset.navLink ?? ''))
      .filter((section): section is HTMLElement => section !== null);
    let pending = false;
    const spy = () => {
      pending = false;
      const probe = window.innerHeight * 0.4;
      let active = -1;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= probe) active = index;
      });
      navLinks.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const link = navLinks[active];
      navEl.style.setProperty('--no', link ? '1' : '0');
      if (link) navEl.style.setProperty('--nx', `${link.offsetLeft + link.offsetWidth / 2}px`);
    };
    spy();
    const schedule = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(spy);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }

  if (menu) {
    // Close the mobile menu after choosing a section, on Escape, or on an outside click.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (menu.open = false)));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
