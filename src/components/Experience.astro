---
import type { Content } from '../i18n';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { experience } = t;
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="flow-node" aria-hidden="true" data-flow-node></span>
      <h2 id="experience-title">{experience.title}</h2>
    </div>

    <ol class="timeline" data-timeline>
      {
        experience.items.map((item, index) => (
          <li class:list={['timeline__item', { 'is-current': item.current }]} style={`--reveal-delay: ${index * 120}ms`} data-reveal>
            <p class="timeline__period">{item.period}</p>
            <span class="timeline__node" aria-hidden="true" />
            <div class="timeline__body">
              <h3>{item.org}</h3>
              <p class="timeline__role">{item.role}</p>
              <ul>
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    --period: 190px;
    --rail: 40px;
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    list-style: none;
  }

  /* The signal line, drawn downward as the section enters. */
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: calc(var(--period) + var(--rail) / 2);
    width: 1px;
    background: linear-gradient(180deg, var(--key), var(--accent) 40%, var(--line));
    transform-origin: top;
  }

  :global(html.motion) .timeline::before {
    transform: scaleY(0);
    transition: transform 1.6s var(--ease-out);
  }

  :global(html.motion) .timeline:global(.is-drawn)::before {
    transform: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--period) var(--rail) minmax(0, 1fr);
    align-items: start;
  }

  .timeline__period {
    padding-top: 2px;
    color: var(--label);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .timeline__node {
    justify-self: center;
    width: 13px;
    height: 13px;
    margin-top: 6px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--night);
    box-shadow: 0 0 0 5px var(--night);
  }

  .is-current .timeline__node {
    position: relative;
    background: var(--key);
    border-color: var(--key);
  }

  .is-current .timeline__node::after {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px solid var(--key);
    border-radius: 50%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-current .timeline__node::after {
      animation: live 2.8s var(--ease-out) infinite;
    }
  }

  @keyframes live {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  .timeline__body h3 {
    font-size: var(--fs-h3);
  }

  .timeline__role {
    margin-top: 0.35rem;
    color: var(--text);
    font-size: var(--fs-body);
  }

  .timeline__body ul {
    display: grid;
    gap: 0.6rem;
    max-width: 62ch;
    margin-top: 1.1rem;
    list-style: none;
  }

  .timeline__body ul li {
    position: relative;
    padding-left: 22px;
  }

  .timeline__body ul li::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 2px;
    width: 5px;
    height: 5px;
    border: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  @media (max-width: 760px) {
    .timeline {
      --rail: 30px;
      padding-left: 0;
    }

    .timeline::before {
      left: calc(var(--rail) / 2);
    }

    .timeline__item {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      grid-template-areas:
        'node period'
        '. body';
      row-gap: 6px;
    }

    .timeline__period {
      grid-area: period;
    }

    .timeline__node {
      grid-area: node;
      margin-top: 4px;
    }

    .timeline__body {
      grid-area: body;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          timeline.classList.add('is-drawn');
          observer.disconnect();
        }
      },
      { threshold: 0.15 },
    );
    observer.observe(timeline);
  }
</script>
