---
import '@fontsource-variable/sora/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import plexMono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import type { Content, Locale } from '../i18n';
import heroFrames from '../content/hero-frames.json';

interface Props {
  locale: Locale;
  t: Content;
}

const { locale, t } = Astro.props;
const site = Astro.site ?? new URL('https://nicolasosorioarias.com');
const enUrl = new URL('/', site).href;
const esUrl = new URL('/es/', site).href;
const canonical = locale === 'en' ? enUrl : esUrl;
// 1200x630 share image built by scripts/build-og.mjs from the hero close-up.
const ogImage = new URL(`/og/og-${locale}.jpg`, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolás Osorio Arias',
  jobTitle: 'Senior Software Engineer, Full-Stack & AI Product',
  url: canonical,
  image: ogImage,
  email: `mailto:${t.contact.email}`,
  sameAs: [t.contact.linkedinHref],
  knowsAbout: t.stack.items,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0A1222" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href={`${heroFrames.variants.desktop.path}000.avif`} type="image/avif" media="(min-width: 760px)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${heroFrames.variants.mobile.path}000.avif`} type="image/avif" media="(max-width: 759px)" fetchpriority="high" />

    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Nicolás Osorio" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={t.meta.alternateLocale} />
    <meta property="profile:first_name" content="Nicolás" />
    <meta property="profile:last_name" content="Osorio Arias" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <script is:inline>
      // Enable entrance motion only when the visitor allows it. Content stays visible otherwise.
      // The scroll-driven hero sequence also needs a capable device and no data saver;
      // everyone else gets the static close-up. Set before first paint to avoid layout shift.
      (function () {
        var root = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var connection = navigator.connection;
        var lowPower = (navigator.hardwareConcurrency || 4) <= 2 || (connection && connection.saveData);
        if (!reduce) root.classList.add('motion');
        if (!reduce && !lowPower) root.classList.add('seq');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
