---
import '@fontsource-variable/sora/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import plexMono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import type { Content, Locale } from '../i18n';
import heroFrames from '../content/hero-frames.json';

interface Props {
  locale: Locale;
  t: Content;
  /** Error pages: no canonical, alternates or structured data, and kept out of search results. */
  notFound?: boolean;
  title?: string;
}

const { locale, t, notFound = false, title } = Astro.props;
const site = Astro.site ?? new URL('https://nicolasosorioarias.com');
const enUrl = new URL('/', site).href;
const esUrl = new URL('/es/', site).href;
const canonical = locale === 'en' ? enUrl : esUrl;
// 1200x630 share image built by scripts/build-og.mjs from the hero close-up.
const ogImage = new URL(`/og/og-${locale}.jpg`, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolás Osorio Arias',
  jobTitle: 'Senior Software Engineer, Full-Stack & AI Product',
  url: canonical,
  image: ogImage,
  email: `mailto:${t.contact.email}`,
  sameAs: [t.contact.linkedinHref, t.contact.githubHref],
  knowsAbout: t.stack.items,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    {notFound && <meta name="robots" content="noindex" />}
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Nicolás Osorio Arias" />
    <meta name="theme-color" content="#0A1222" />
    {
      !notFound && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="es" href={esUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono500} as="font" type="font/woff2" crossorigin />

    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Nicolás Osorio" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={t.meta.alternateLocale} />
    <meta property="profile:first_name" content="Nicolás" />
    <meta property="profile:last_name" content="Osorio Arias" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <script
      is:inline
      define:vars={{
        heroImages: notFound
          ? null
          : Object.fromEntries(
              Object.entries(heroFrames.variants).map(([name, variant]) => [
                name,
                { frame: `${variant.path}000.avif`, still: `${variant.still}.avif`, width: variant.width },
              ]),
            ),
      }}
    >
      // Enable entrance motion only when the visitor allows it. Content stays visible otherwise.
      // The scroll-driven hero sequence also needs a capable device and no data saver;
      // everyone else gets the static close-up. Set before first paint to avoid layout shift.
      (function () {
        var root = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var connection = navigator.connection;
        var phone = window.matchMedia('(max-width: 759px)').matches;
        var slow = connection && /^(slow-2g|2g|3g)$/.test(connection.effectiveType || '');
        // Data saver anywhere, 2-core devices, and phones on slow connections get the static close-up.
        var lowPower = (navigator.hardwareConcurrency || 4) <= 2 || (connection && connection.saveData) || (phone && slow);
        var sequence = !reduce && !lowPower;
        if (!reduce) root.classList.add('motion');
        if (sequence) root.classList.add('seq');

        // Preload only the one hero image this visitor will see first: frame 0 of the chosen set,
        // or the static close-up. The 2560 set is for high-DPR desktops on fast, non-metered links.
        if (!heroImages) return;
        var hiDpr = (window.devicePixelRatio || 1) >= 1.5 && window.innerWidth >= 1024;
        var metered = (connection && connection.saveData) || slow;
        var set = phone ? 'mobile' : hiDpr && !metered ? 'desktop2x' : 'desktop';
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.type = 'image/avif';
        if (sequence) {
          link.href = heroImages[set].frame;
        } else if (phone) {
          link.href = heroImages.mobile.still;
        } else {
          // Same candidates as the still <picture>, so the browser reuses the preload instead of fetching twice.
          link.setAttribute('imagesrcset', heroImages.desktop.still + ' ' + heroImages.desktop.width + 'w, ' + heroImages.desktop2x.still + ' ' + heroImages.desktop2x.width + 'w');
          link.setAttribute('imagesizes', '100vw');
        }
        link.setAttribute('fetchpriority', 'high');
        document.head.appendChild(link);
      })();
    </script>
    {!notFound && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
